# .env example for imambot

# Bot token
TOKEN=
# Optional alternative name
# DISCORD_TOKEN=

# Primary guild/server ID to check for tag
GUILD_ID=

# Tag role settings
TAG_ROLE_ID=
TAG_LOG_CHANNEL_ID=

# Presence (custom status) role settings
PRESENCE_ROLE_ID=
PRESENCE_LOG_CHANNEL_ID=
PRESENCE_DURUM=
PRESENCE_SURUM=eski

# Backwards compatibility / alternate names
ROLE_ID=
LOG_CHANNEL_ID=
PRESENCE_ROL_ID=
PRESENCE_LOG_ID=
DURUM=
SURUM=
